# Cinematic Multi-Language Video Studio - Backend Environment Variables
# Copy this file to .env and customize as needed

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Cinematic Multi-Language Video Studio
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# Backend Settings
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# Project storage (mounted as volume)
PROJECT_ROOT=/app/projects

# FFmpeg (uses system ffmpeg in container)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ===========================================
# AI Provider Settings
# ===========================================
# Default AI provider: local_python or notebooklm
AI_DEFAULT_PROVIDER=local_python

# Allow external provider selection in UI
AI_ALLOW_EXTERNAL_PROVIDER=true

# Automatically fall back to local provider if external fails
AI_FALLBACK_TO_LOCAL=false

# ===========================================
# NotebookLM / External API (Optional)
# ===========================================
NOTEBOOKLM_ENABLED=false
NOTEBOOKLM_API_KEY=
NOTEBOOKLM_ENDPOINT=
NOTEBOOKLM_PROJECT_ID=
NOTEBOOKLM_MODEL=
NOTEBOOKLM_TIMEOUT_SECONDS=300
NOTEBOOKLM_MAX_RETRIES=3

# ===========================================
# Local Model Settings
# ===========================================
# Base directory for local models (mounted as volume)
LOCAL_MODELS_DIR=/app/models

# Hugging Face cache directory
HF_HOME=/app/cache/huggingface
TRANSFORMERS_CACHE=/app/cache/huggingface
HF_DATASETS_CACHE=/app/cache/huggingface

# ===========================================
# Performance Settings
# ===========================================
# Maximum concurrent GPU-heavy jobs
MAX_CONCURRENT_GPU_JOBS=1

# Enable CPU fallback for models that support it
ENABLE_CPU_FALLBACK=true

# Model idle timeout before unloading (seconds)
MODEL_IDLE_TIMEOUT=300

# ===========================================
# Security Settings
# ===========================================
# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:80,http://localhost:4200,http://localhost:8000

# Maximum upload size (bytes, default 500MB)
MAX_UPLOAD_SIZE=524288000

# ===========================================
# FFmpeg Settings
# ===========================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ===========================================
# Storage Settings
# ===========================================
# Project root directory (mounted as volume)
PROJECT_ROOT=/app/projects

# Max project size in GB
MAX_PROJECT_SIZE_GB=50

# Auto-cleanup temporary files
AUTO_CLEANUP_TEMP=true

# Temp file retention in days
TEMP_RETENTION_DAYS=30

# Backup settings
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_LOCATION=/app/backups

# ===========================================
# Performance Settings
# ===========================================
MAX_CONCURRENT_GPU_JOBS=1
ENABLE_CPU_FALLBACK=true
MODEL_IDLE_TIMEOUT_MINUTES=5
MAX_MEMORY_USAGE_PERCENT=85
ENABLE_MODEL_OFFLOADING=true

# ===========================================
# Logging Settings
# ===========================================
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGGING=false
LOG_RETENTION_DAYS=30
MAX_LOG_FILE_SIZE_MB=10
STRUCTURED_LOGGING=true