# Cinematic Multi-Language Video Studio - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# NOTEBOOKLM / EXTERNAL AI PROVIDER CONFIGURATION (OPTIONAL)
# =============================================================================
# Enable NotebookLM/API integration
NOTEBOOKLM_ENABLED=false

# NotebookLM API credentials (if available)
# NOTE: NotebookLM does not currently have a public API.
# This is a placeholder for future API integrations or custom endpoints.
NOTEBOOKLM_API_KEY=
NOTEBOOKLM_ENDPOINT=
NOTEBOOKLM_PROJECT_ID=
NOTEBOOKLM_MODEL=

# NotebookLM request settings
NOTEBOOKLM_TIMEOUT_SECONDS=300
NOTEBOOKLM_MAX_RETRIES=3

# =============================================================================
# PROVIDER DEFAULTS
# =============================================================================
# Default provider for AI operations: local_python | notebooklm
AI_DEFAULT_PROVIDER=local_python

# Allow external provider selection in UI
AI_ALLOW_EXTERNAL_PROVIDER=true

# Automatically fall back to local provider if external fails
AI_FALLBACK_TO_LOCAL=false

# =============================================================================
# LOCAL MODEL CONFIGURATION
# =============================================================================
# Base directory for local models (optional, can be set per-model in models.yaml)
LOCAL_MODELS_DIR=

# Hugging Face cache directory (optional)
HF_HOME=
TRANSFORMERS_CACHE=
HF_DATASETS_CACHE=

# =============================================================================
# FFmpeg CONFIGURATION
# =============================================================================
# FFmpeg executable path (if not in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Project root directory (can be overridden in UI Settings)
PROJECT_ROOT=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode (more verbose logging, test endpoints)
DEBUG=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Maximum concurrent GPU-heavy operations
MAX_CONCURRENT_GPU_JOBS=1

# Enable CPU fallback for models that support it
ENABLE_CPU_FALLBACK=true

# Model idle timeout before unloading (seconds)
MODEL_IDLE_TIMEOUT=300

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# CORS origins (comma-separated, for development)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Maximum upload size (bytes, default 500MB)
MAX_UPLOAD_SIZE=524288000

# =============================================================================
# TEST MODE SETTINGS
# =============================================================================
# Enable test mode (uses mock providers, no external dependencies)
TEST_MODE=false

# Test project fixture directory
TEST_FIXTURES_DIR=tests/fixtures/project